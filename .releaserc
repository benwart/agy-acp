{
  "branches": [
    "main"
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "uv version ${nextRelease.version} --no-sync && uv run --no-project python -c 'from pathlib import Path; import re; p = Path(\"src/agy_acp/__init__.py\"); p.write_text(re.sub(r\"__version__\\s*=\\s*\\\"[^\\\"]+\\\"\", \"__version__ = \\\"${nextRelease.version}\\\"\", p.read_text(encoding=\"utf-8\")), encoding=\"utf-8\")'"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "pyproject.toml",
          "uv.lock",
          "src/agy_acp/__init__.py",
          "CHANGELOG.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github"
    ]
  ]
}
