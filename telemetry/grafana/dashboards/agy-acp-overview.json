          "expr": "clamp_max(100 * (max by (quota_group) (agy_acp_quota_remaining_fraction{window=\"7d\"}) * max by (quota_group) (agy_acp_quota_5h_per_7d_ratio)) / clamp_min((max by (quota_group) (agy_acp_quota_reset_timestamp_seconds{window=\"7d\"}) - time()) / 18000, 1), 100)",
