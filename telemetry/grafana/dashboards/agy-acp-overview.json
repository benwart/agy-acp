      "targets": [
        {
          "expr": "max by (quota_group) (agy_acp_quota_5h_per_7d_ratio)",
          "legendFormat": "R persisted ({{quota_group}})",
          "refId": "A"
        },
        {
          "expr": "sum by (quota_group) (rate(agy_acp_quota_fraction_burnt_total{window=\"5h\"}[6h])) / clamp_min(sum by (quota_group) (rate(agy_acp_quota_fraction_burnt_total{window=\"7d\"}[6h])), 1e-9)",
          "legendFormat": "R live 6h ({{quota_group}})",
          "refId": "B"
        }
      ],
      "title": "How Many 5h Quotas Exhaust One 7d Quota (R)",
      "type": "stat"
    },
    {
