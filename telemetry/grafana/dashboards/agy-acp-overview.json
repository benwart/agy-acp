    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Empirical number of full 5h quotas required to exhaust 100% of one 7d quota (compared against 33.6 five-hour windows per 7-day week).",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 33.6 }
