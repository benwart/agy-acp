      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum by (state) (agy_acp_sessions_count)", "legendFormat": "{{state}}", "refId": "A" }],
      "title": "Sessions (Active / Persisted)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
