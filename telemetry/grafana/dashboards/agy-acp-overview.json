      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 13 },
      "id": 33,
      "targets": [
        {
          "expr": "max by (quota_group) (agy_acp_quota_remaining_fraction{window=\"7d\"}) * max by (quota_group) (agy_acp_quota_5h_per_7d_ratio)",
