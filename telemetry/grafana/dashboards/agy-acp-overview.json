        { "expr": "max(agy_acp_g1_overage_credits)", "legendFormat": "G1 Overage", "refId": "C" },
        { "expr": "max by (quota_group, window) (agy_acp_quota_bucket_remaining_credits)", "legendFormat": "{{quota_group}} ({{window}})", "refId": "D" }
      ],
      "title": "Plan, Window & G1 Overage Credits",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Current quota burn rate divided by sustainable rate to scheduled reset (< 1.0x = safe until reset; > 1.0x = will exhaust early).",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.85 },
              { "color": "red", "value": 1.0 }
            ]
          },
          "unit": "x"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "id": 30,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "(sum by (quota_group, window) (rate(agy_acp_quota_fraction_burnt_total[1h])) or (0 * max by (quota_group, window) (agy_acp_quota_remaining_fraction))) / clamp_min(max by (quota_group, window) (agy_acp_quota_remaining_fraction) / clamp_min(max by (quota_group, window) (agy_acp_quota_reset_timestamp_seconds) - time(), 1), 1e-9)",
          "legendFormat": "{{quota_group}} ({{window}})",
          "refId": "A"
        }
      ],
      "title": "Will I Run Out? — Burn Pace Ratio (< 1.0x Safe vs. > 1.0x Exhaustion Risk)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Time remaining until scheduled reset vs. net exhaustion safety margin (+s safe headroom past reset; negative = deficit before reset).",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0 },
              { "color": "green", "value": 3600 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "id": 31,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "clamp_min(max by (quota_group, window) (agy_acp_quota_reset_timestamp_seconds) - time(), 0)",
          "legendFormat": "reset in: {{quota_group}} ({{window}})",
          "refId": "A"
        },
        {
          "expr": "clamp_max(max by (quota_group, window) (agy_acp_quota_remaining_fraction) / clamp_min(sum by (quota_group, window) (rate(agy_acp_quota_fraction_burnt_total[1h])), 1e-7), 604800) - clamp_min(max by (quota_group, window) (agy_acp_quota_reset_timestamp_seconds) - time(), 0)",
          "legendFormat": "margin: {{quota_group}} ({{window}})",
          "refId": "B"
        }
      ],
      "title": "Scheduled Reset Countdown & Exhaustion Safety Margin",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
